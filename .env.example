# Copy to .env and adjust. All values are validated at startup (src/config/env.ts);
# the server refuses to start if anything is invalid.

NODE_ENV=development            # development | production | test
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# Set when running behind a load balancer / reverse proxy so req.ip, req.protocol
# and Secure cookies work: a hop count (1), true, or a list of trusted IPs/subnets.
# On AKS behind Application Gateway use the gateway subnet CIDR, e.g. 10.225.0.0/24.
TRUST_PROXY=false

# On SIGTERM, fail /readyz and keep serving this long before closing (lets the load balancer drain).
# 0 locally; ~30000 on AKS with AGIC. terminationGracePeriodSeconds must exceed this + 10s.
SHUTDOWN_DELAY_MS=0

MONGO_URI=mongodb://localhost:27017
MONGO_DB=app
# Connections per instance; keep max replicas × this below the Atlas tier's connection limit.
MONGO_MAX_POOL_SIZE=20

# Comma-separated. The first secret signs new cookies; older ones are still accepted,
# so rotate by prepending a new secret. Each must be >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRETS=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_NAME=sid
SESSION_TTL_SECONDS=28800        # 8h. Users disabled in Entra keep access until their session expires
COOKIE_DOMAIN=
COOKIE_SECURE=                  # defaults to true when NODE_ENV=production (cannot be false there)

# --- Sign-in: Microsoft Entra ID (OpenID Connect) ---
# Public origin users reach (behind the gateway). Redirect URI = PUBLIC_BASE_URL + /api/auth/callback,
# which must be registered in the Entra app registration (platform "Web").
PUBLIC_BASE_URL=http://localhost:3000
# Use the tenant ID GUID, not a domain name (the issuer in Entra's metadata is always GUID-based).
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<application-client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_SCOPES=openid profile email

# Comma-separated origins allowed to call the API with credentials (leave empty for same-origin only)
CORS_ORIGINS=

STATIC_DIR=public
STATIC_MAX_AGE=1h

# Built SPAs (e.g. Angular dist/<project>/browser), each served under /<name>/ with deep-link fallback.
# Comma-separated name:dir pairs; each dir must contain index.html. Build Angular with --base-href /<name>/
# SPA_APPS=inventory:../inventory/dist/inventory/browser,sale:../sale/dist/sale/browser
SPA_APPS=

BODY_LIMIT=100kb
